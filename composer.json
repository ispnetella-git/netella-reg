{
    "name": "ispnetella/librenms-netella-reg",
    "description": "LibreNMS v2 plugin (composer): modular inventory of VLANs and IP addressing built from LibreNMS data, with manual entries and a full change log",
    "type": "library",
    "license": "GPL-3.0-or-later",
    "keywords": ["librenms", "librenms-plugin", "ipam", "vlan", "inventory"],
    "require": {
        "php": ">=8.2",
        "librenms/plugin-interfaces": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Ispnetella\\NetellaReg\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ispnetella\\NetellaReg\\NetellaRegProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
